{
  "name": "model-citizen",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "dev": "astro dev --port 4321 --host 127.0.0.1",
    "build": "astro build && pagefind --site dist --output-subdir pagefind --glob \"**/*.html\"",
    "preview": "astro preview --port 4322 --host 127.0.0.1",
    "check": "astro check",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:fast": "node scripts/sync-assets.mjs && astro build",
    "prebuild": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "astro": "7.3.8",
    "dexie": "4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6.2.6",
    "pagefind": "^1.5.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@lezer/common": "1.5.3",
    "qs": "6.16.0"
  }
}
