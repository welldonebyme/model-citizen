{"schema":1,"repo":"jaffle_dbt","from":"ch10","to":"ch11","from_commit":"07cf7750dd4fe26cc42aed44ed0827d2c1198d3f","to_commit":"e1cd8865c728cda47211a23d46e6cf9f72f64dc6","commits":[{"commit":"e1cd8865c728cda47211a23d46e6cf9f72f64dc6","short":"e1cd886","subject":"Macros and packages: cents_to_dollars, dbt_utils, audit_helper, payment method pivot, fct_order_items, print_row_counts"}],"stats":{"files_changed":11,"added":7,"removed":0,"modified":4,"insertions":169,"deletions":9},"files":[{"path":"analyses/audit_fct_monthly_revenue.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":28,"section":"","lines":["+{#","+    Compare the refactored fct_monthly_revenue with the legacy SQL of Chapter 9,","+    using the audit_helper package. Run it with:","+        dbt show --select audit_fct_monthly_revenue","+#}","+","+{% set legacy_query %}","+SELECT DATE_TRUNC('month', X.ORDER_DATE) AS ORDER_MONTH, C.COUNTRY,","+COUNT(*) AS NUMBER_OF_ORDERS, SUM(X.PAID_CENTS) / 100 AS REVENUE","+FROM (SELECT O.ID, O.USER_ID, O.ORDER_DATE,","+        COALESCE((SELECT SUM(P.AMOUNT) FROM PRACTICE.STRIPE.PAYMENTS P","+                  WHERE P.ORDERID = O.ID AND P.STATUS = 'success'), 0) AS PAID_CENTS","+      FROM PRACTICE.JAFFLE_SHOP.ORDERS O","+      WHERE O.STATUS NOT IN ('returned', 'return_pending')) X","+LEFT JOIN (SELECT ID, COUNTRY FROM PRACTICE.JAFFLE_SHOP.CUSTOMERS) C ON C.ID = X.USER_ID","+GROUP BY 1, 2","+{% endset %}","+","+{% set refactored_query %}","+select order_month, country, number_of_orders, revenue","+from {{ ref('fct_monthly_revenue') }}","+{% endset %}","+","+{{ audit_helper.compare_queries(","+    a_query=legacy_query,","+    b_query=refactored_query,","+    summarize=true","+) }}"]}],"new_mode":"100644","insertions":28,"deletions":0},{"path":"macros/cents_to_dollars.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":7,"section":"","lines":["+{#","+    Convert an integer amount in cents into dollars, as an exact decimal.","+    Example: {{ cents_to_dollars('amount') }}  ->  cast(amount / 100 as decimal(16, 2))","+#}","+{% macro cents_to_dollars(column_name, scale=2) -%}","+    cast({{ column_name }} / 100 as decimal(16, {{ scale }}))","+{%- endmacro %}"]}],"new_mode":"100644","insertions":7,"deletions":0},{"path":"macros/print_row_counts.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":28,"section":"","lines":["+{#","+    Print the number of rows of every model built as one of the given","+    materializations. Run it with:","+        dbt run-operation print_row_counts","+        dbt run-operation print_row_counts --args '{materializations: [view]}'","+#}","+{% macro print_row_counts(materializations=['table', 'incremental']) %}","+","+    {% if execute %}","+        {% for node in graph.nodes.values()","+              | selectattr('resource_type', 'equalto', 'model')","+              | sort(attribute='name') %}","+            {% if node.config.materialized in materializations %}","+                {% set relation = adapter.get_relation(","+                    database=node.database,","+                    schema=node.schema,","+                    identifier=node.alias) %}","+                {% if relation is none %}","+                    {{ log(node.name ~ ': not built yet', info=true) }}","+                {% else %}","+                    {% set result = run_query('select count(*) from ' ~ relation) %}","+                    {{ log(node.name ~ ': ' ~ result.columns[0].values()[0] ~ ' rows', info=true) }}","+                {% endif %}","+            {% endif %}","+        {% endfor %}","+    {% endif %}","+","+{% endmacro %}"]}],"new_mode":"100644","insertions":28,"deletions":0},{"path":"models/intermediate/int_orders__payment_methods_pivoted.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":25,"section":"","lines":["+{%- set p