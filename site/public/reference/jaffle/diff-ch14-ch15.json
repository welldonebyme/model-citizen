{"schema":1,"repo":"jaffle_dbt","from":"ch14","to":"ch15","from_commit":"de1ecde6afe411c4b5f43b00460919d9fc9c3d46","to_commit":"b111300bdafb6573636b8c4fa14b8fe27e6bff80","commits":[{"commit":"b111300bdafb6573636b8c4fa14b8fe27e6bff80","short":"b111300","subject":"Python model customer_segments (pandas)"}],"stats":{"files_changed":2,"added":1,"removed":0,"modified":1,"insertions":46,"deletions":0},"files":[{"path":"models/marts/_marts__models.yml","status":"modified","binary":false,"hunks":[{"old_start":32,"old_lines":3,"new_start":32,"new_lines":16,"section":"models:","lines":["     description: Quantity and revenue per day and product (microbatch incremental model).","     config:","       tags: ['finance']","+","+  - name: customer_segments","+    description: One row per customer with a marketing segment and a value tier (Python model, pandas).","+    config:","+      tags: ['marketing']","+    columns:","+      - name: customer_id","+        description: Primary key.","+        data_tests:","+          - unique","+          - not_null","+      - name: segment","+        description: no orders, new, regular or loyal."]}],"insertions":13,"deletions":0},{"path":"models/marts/customer_segments.py","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":33,"section":"","lines":["+import pandas as pd","+","+","+def model(dbt, session):","+    # configs can be set here (like config() in SQL) or in a properties file","+    dbt.config(materialized=\"table\")","+","+    # dbt.ref() returns a DuckDB relation; .df() turns it into a pandas DataFrame","+    customers = dbt.ref(\"dim_customers\").df()","+","+    def segment(row):","+        if row[\"number_of_orders\"] == 0:","+            return \"no orders\"","+        if row[\"number_of_orders\"] >= 4 or row[\"lifetime_value\"] >= 100:","+            return \"loyal\"","+        if row[\"number_of_orders\"] >= 2:","+            return \"regular\"","+        return \"new\"","+","+    customers[\"segment\"] = customers.apply(segment, axis=1)","+","+    # value tier: quartiles of lifetime value among customers who ordered","+    buyers = customers[\"number_of_orders\"] > 0","+    customers[\"value_tier\"] = \"none\"","+    customers.loc[buyers, \"value_tier\"] = pd.qcut(","+        customers.loc[buyers, \"lifetime_value\"].rank(method=\"first\"),","+        q=4,","+        labels=[\"bronze\", \"silver\", \"gold\", \"platinum\"],","+    ).astype(str)","+","+    return customers[","+        [\"customer_id\", \"country\", \"number_of_orders\", \"lifetime_value\", \"segment\", \"value_tier\"]","+    ]"]}],"new_mode":"100644","insertions":33,"deletions":0}]}
