ue per order month and customer country (returned orders excluded).","     config:","+      group: finance","+      access: public","       tags: ['finance']"," ","-  - name: dim_customers","-    description: One row per customer, with order history and lifetime value.","-    config:","-      tags: ['marketing']","-      meta:","-        contains_pii: true","-","   - name: fct_order_items","     description: One row per order line (order x product), with the line amount in dollars.","     config:","+      group: finance","+      access: protected","       event_time: order_date","       tags: ['finance']"," ","   - name: fct_order_items_daily","     description: Quantity and revenue per day and product (microbatch incremental model).","     config:","+      group: finance","+      access: protected","       tags: ['finance']"," ","   - name: customer_segments","     description: One row per customer with a marketing segment and a value tier (Python model, pandas).","     config:","+      group: marketing","+      access: protected","       tags: ['marketing']","     columns:","       - name: customer_id"]}],"insertions":10,"deletions":7},{"path":"models/marts/dim_customers.yml","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":64,"section":"","lines":["+version: 2","+","+models:","+  - name: dim_customers","+    description: One row per customer, with order history and lifetime value.","+    latest_version: 2","+    config:","+      tags: ['marketing']","+      meta:","+        contains_pii: true","+      group: marketing","+      access: public","+      contract:","+        enforced: true","+    constraints:","+      - type: check","+        expression: \"lifetime_value >= 0\"","+        name: lifetime_value_not_negative","+    columns:","+      - name: customer_id","+        description: Primary key of the customer.","+        data_type: integer","+        constraints:","+          - type: not_null","+          - type: primary_key","+      - name: first_name","+        data_type: varchar","+      - name: last_name","+        data_type: varchar","+      - name: email","+        description: Email in lower case (NULL when unknown).","+        data_type: varchar","+        constraints:","+          - type: unique","+      - name: country","+        data_type: varchar","+      - name: region","+        description: Sales region, from the country_regions seed.","+        data_type: varchar","+      - name: first_order_date","+        data_type: date","+      - name: most_recent_order_date","+        data_type: date","+      - name: number_of_orders","+        data_type: bigint","+        constraints:","+          - type: not_null","+      - name: lifetime_value","+        description: Total of the successful payments, in dollars.","+        data_type: decimal(38, 2)","+        constraints:","+          - type: not_null","+","+    versions:","+      - v: 1","+        defined_in: dim_customers      # the original file dim_customers.sql","+        deprecation_date: 2027-06-30   # consumers must move to v2 before this date","+      - v: 2                           # file dim_customers_v2.sql (default name)","+        columns:","+          - include: all","+            exclude: [first_name, last_name]","+          - name: full_name","+            description: First name and last name.","+            data_type: varchar"]}],"new_mode":"100644","insertions":64,"deletions":0},{"path":"models/marts/dim_customers_v2.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":57,"section":"","lines":["+-- Version 2 of dim_customers: first_name and last_name are replaced by full_name (breaking change)","+with","+","+customers as (","+","+    select * from {{ ref('stg_jaffle_shop__customers') }}","+","+),","+","+orders as (","+","+    select * from {{ ref('fct_orders') }}","+","+),","+","+country_regions as (","+","+    select * from {{ ref('country_regions') }}","+","+),","+","+customer_orders as (","+","+    select","+        customer_id,","+        min(order_date) as first_order_date,","+        max(order_date) as most_recent_order_date,","+        count(order_id) as number_of_orders,","+        sum(amount) as lifetime_value","+","+    from orders","+    group by customer_id","+","+),","+","+final as (","+","+    select","+        customers.customer_id,","+        customers.first_name || ' ' || customers.last_name as full_name,","+        customers.email,","+        customers.country,","+        country_regions.region,","+        customer_orders.first_order_date,","+        customer_orders.most_recent_order_date,","+        coalesce(customer_orders.number_of_orders, 0) as number_of_orders,","+        coalesce(customer_orders.lifetime_value, 0) as lifetime_value","+","+    from customers","+    left join customer_orders","+        on customers.customer_id = customer_orders.customer_id","+    left join country_regions","+        on customers.country = country_regions.country","+","+)","+","+select * from final"]}],"new_mode":"100644","insertions":57,"deletions":0}]}
