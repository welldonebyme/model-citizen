oup by order_id","+","+)","+","+select","+    orders.order_id,","+    orders.amount,","+    items.items_amount","+","+from {{ ref('fct_orders') }} as orders","+inner join items","+    on orders.order_id = items.order_id","+where orders.amount > 0","+  and orders.amount <> items.items_amount"]}],"new_mode":"100644","insertions":25,"deletions":0},{"path":"tests/assert_payments_match_order_totals.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":37,"section":"","lines":["+-- Singular test: for every order, the amount in fct_orders must equal","+--   (1) the sum of its 4 payment-method columns, and","+--   (2) the sum of its successful payments in stg_stripe__payments.","+-- The test FAILS if this query returns at least one row.","+","+with","+","+orders as (","+","+    select * from {{ ref('fct_orders') }}","+","+),","+","+payments as (","+","+    select","+        order_id,","+        sum(amount) as paid_amount","+    from {{ ref('stg_stripe__payments') }}","+    where status = 'success'","+    group by order_id","+","+)","+","+select","+    orders.order_id,","+    orders.amount,","+    orders.bank_transfer_amount + orders.coupon_amount","+        + orders.credit_card_amount + orders.gift_card_amount as sum_of_methods,","+    coalesce(payments.paid_amount, 0) as paid_amount","+","+from orders","+left join payments","+    on orders.order_id = payments.order_id","+where orders.amount <> orders.bank_transfer_amount + orders.coupon_amount","+                       + orders.credit_card_amount + orders.gift_card_amount","+   or orders.amount <> coalesce(payments.paid_amount, 0)"]}],"new_mode":"100644","insertions":37,"deletions":0},{"path":"tests/generic/test_is_positive.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":11,"section":"","lines":["+{#","+    Custom generic test: fails for every row where the column is not positive.","+    Use allow_zero: true to accept 0 (for