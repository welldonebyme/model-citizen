{"schema":1,"repo":"shopflow_dbt","from":"empty","to":"m00","from_commit":null,"to_commit":"63700cb492a3f4f5b9c323b8a316dfd16eb236c5","commits":[{"commit":"63700cb492a3f4f5b9c323b8a316dfd16eb236c5","short":"63700cb","subject":"m00: project setup (dbt init, profile shopflow, no example models)"}],"stats":{"files_changed":10,"added":10,"removed":0,"modified":0,"insertions":62,"deletions":0},"files":[{"path":".gitignore","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":8,"section":"","lines":["+target/","+dbt_packages/","+logs/","+*.duckdb","+*.duckdb.wal","+prod-artifacts/","+.user.yml","+__pycache__/"]}],"new_mode":"100644","insertions":8,"deletions":0},{"path":"README.md","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":23,"section":"","lines":["+# shopflow_dbt -- capstone reference solution (Chapter 26)","+","+This repository is the reference solution of the ShopFlow capstone project of","+*The dbt Analytics Engineering Bible*. Each milestone of Chapter 26 is one commit","+with an annotated tag: `m00`, `m01`, ... `m14`.","+","+## Layout expected on your machine","+```","+~/dbt-course/","+  shopflow-data/      # copy of labs/capstone (data/, setup.sql, updates/) + shopflow.duckdb","+  shopflow_dbt/       # this dbt project (your own repo)","+```","+Build the raw database once: `cd ~/dbt-course/shopflow-data && duckdb shopflow.duckdb < setup.sql`.","+","+## Use the tags to compare with your work","+```bash","+git tag -n                      # list milestones with their message","+git diff m03 m04 --stat         # what changed in one milestone","+git checkout m04                # look at the solution of milestone 4 (read-only visit)","+git switch main                 # come back","+```","+Copy `profiles.example.yml` into `~/.dbt/profiles.yml` (profile name `shopflow`).","+Always run dbt from this folder (the database path is relative)."]}],"new_mode":"100644","insertions":23,"deletions":0},{"path":"analyses/.gitkeep","status":"added","binary":false,"hunks":[],"new_mode":"100644","insertions":0,"deletions":0},{"path":"dbt_project.yml","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":16,"section":"","lines":["+name: 'shopflow_dbt'","+version: '1.0.0'","+","+# the profile (connection) defined in ~/.dbt/profiles.yml","+profile: 'shopflow'","+","+model-paths: [\"models\"]","+analysis-paths: [\"analyses\"]","+test-paths: [\"tests\"]","+seed-paths: [\"seeds\"]","+macro-paths: [\"macros\"]","+snapshot-paths: [\"snapshots\"]","+","+clean-targets:","+  - \"target\"","+  - \"dbt_packages\""]}],"new_mode":"100644","insertions":16,"deletions":0},{"path":"macros/.gitkeep","status":"added","binary":false,"hunks":[],"new_mode":"100644","insertions":0,"deletions":0},{"path":"models/.gitkeep","status":"added","binary":false,"hunks":[],"new_mode":"100644","insertions":0,"deletions":0},{"path":"profiles.example.yml","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":15,"section":"","lines":["+# Copy this block into ~/.dbt/profiles.yml (do NOT commit your real profiles.yml).","+# Run dbt from the shopflow_dbt folder: the default path is relative to it.","+shopflow:","+  target: dev","+  outputs:","+    dev:","+      type: duckdb","+      path: \"{{ env_var('SHOPFLOW_DB_PATH', '../shopflow-data/shopflow.duckdb') }}\"","+      schema: dbt_adnane","+      threads: 4","+    prod:","+      type: duckdb","+      path: \"{{ env_var('SHOPFLOW_DB_PATH', '../shopflow-data/shopflow.duckdb') }}\"","+      schema: prod","+      threads: 4"]}],"new_mode":"100644","insertions":15,"deletions":0},{"path":"seeds/.gitkeep","status":"added","binary":false,"hunks":[],"new_mode":"100644","insertions":0,"deletions":0},{"path":"snapshots/.gitkeep","status":"added","binary":false,"hunks":[],"new_mode":"100644","insertions":0,"deletions":0},{"path":"tests/.gitkeep","status":"added","binary":f