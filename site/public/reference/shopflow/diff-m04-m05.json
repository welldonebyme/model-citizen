e rate and round to cents.","+    The parentheses matter: the macro pastes TEXT, so convert_to_eur('a - b')","+    must become (a - b) * rate, not a - b * rate.","+-#}","+{% macro convert_to_eur(amount, rate_column='rate_to_eur') -%}","+    round(({{ amount }}) * {{ rate_column }}, 2)","+{%- endmacro %}"]}],"new_mode":"100644","insertions":8,"deletions":0},{"path":"macros/generate_schema_name.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":11,"section":"","lines":["+{#-","+    dev / ci : every model goes to the target schema (dbt_adnane, ci...)","+    prod     : a model with a custom schema goes to that schema (staging, finance...)","+-#}","+{% macro generate_schema_name(custom_schema_name, node) -%}","+    {%- if target.name == 'prod' and custom_schema_name is not none -%}","+        {{ custom_schema_name | trim }}","+    {%- else -%}","+        {{ target.schema }}","+    {%- endif -%}","+{%- endmacro %}"]}],"new_mode":"100644","insertions":11,"deletions":0},{"path":"macros/profile_key.sql","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":16,"section":"","lines":["+{#-","+    dbt run-operation profile_key --args '{source_name: web_analytics, table_name: events, key: event_id}'","+    Prints the number of rows, distinct keys and duplicated keys of a source table.","+-#}","+{% macro profile_key(source_name, table_name, key) %}","+    {% set relation = source(source_name, table_name) %}","+    {% set sql %}","+        select count(*) as n_rows,","+               count(distinct {{ key }}) as n_keys,","+               count(*) - count(distinct {{ key }}) as n_duplicates","+        from {{ relation }}","+    {% endset %}","+    {% set row = run_query(sql).rows[0] %}","+    {{ log(relation ~ ': ' ~ row['n_rows'] ~ ' rows, ' ~ row['n_keys'] ~ ' distinct ' ~ key","+           ~ ', ' ~ row['n_duplicates'] ~ ' duplicates', info=True) }}","+{% endmacro %}"]}],"new_mode":"100644"