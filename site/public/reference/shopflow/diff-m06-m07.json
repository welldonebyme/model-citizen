{"schema":1,"repo":"shopflow_dbt","from":"m06","to":"m07","from_commit":"9fccbdbf2116acdd3a9c7718286af70ba1a537e8","to_commit":"1d4a0296c0f47a521d2185be894bf421be2ef944","commits":[{"commit":"1d4a0296c0f47a521d2185be894bf421be2ef944","short":"1d4a029","subject":"m07: unit tests (EUR conversion with ephemeral sql input, dim_customers logic, events dedupe)"}],"stats":{"files_changed":3,"added":3,"removed":0,"modified":0,"insertions":75,"deletions":0},"files":[{"path":"models/intermediate/_int__unit_tests.yml","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":32,"section":"","lines":["+unit_tests:","+  - name: test_eur_conversion_uses_the_rate_of_the_order_month","+    description: >","+      An order is converted to EUR with the rate of ITS month and currency.","+      Net amount = paid - refunded, converted with the same rate.","+    model: int_orders__enriched","+    given:","+      - input: ref('stg_shopflow_app__orders')","+        rows:","+          - {order_id: 1, customer_id: 10, order_at: 2025-07-15 10:00:00, order_date: 2025-07-15, order_status: delivered, currency_code: MAD, updated_at: 2025-07-20 08:00:00}","+          - {order_id: 2, customer_id: 11, order_at: 2025-12-03 09:30:00, order_date: 2025-12-03, order_status: returned, currency_code: USD, updated_at: 2025-12-12 08:00:00}","+      - input: ref('stg_shopflow_app__order_items')","+        rows:","+          - {order_item_id: 1, order_id: 1, quantity: 2, line_amount: 500.00}","+          - {order_item_id: 2, order_id: 2, quantity: 1, line_amount: 80.00}","+      # int_payments__per_order is EPHEMERAL (no relation in the database):","+      # dbt cannot read its columns, so this input MUST use format: sql","+      - input: ref('int_payments__per_order')","+        format: sql","+        rows: |","+          select 1 as order_id, 1000.00 as amount_paid, 0.00 as amount_refunded","+          union all","+          select 2 as order_id, 80.00 as amount_paid, 80.00 as amount_refunded","+      - input: ref('exchange_rates')","+        rows:","+          - {currency_code: MAD, rate_month: 2025-07-01, rate_to_eur: 0.0921}","+          - {currency_code: MAD, rate_month: 2025-08-01, rate_to_eur: 0.0918}","+          - {currency_code: USD, rate_month: 2025-12-01, rate_to_eur: 0.9168}","+    expect:","+      rows:","+        - {order_id: 1, order_total: 500.00, net_amount: 1000.00, order_total_eur: 46.05, net_amount_eur: 92.10}","+        - {order_id: 2, order_total: 80.00, net_amount: 0.00, order_total_eur: 73.34, net_amount_eur: 0.00}"]}],"new_mode":"100644","insertions":32,"deletions":0},{"path":"models/marts/marketing/_marketing__unit_tests.yml","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":25,"section":"","lines":["+unit_tests:","+  - name: test_cancelled_orders_do_not_count","+    description: >","+      number_of_orders and lifetime_value_eur ignore cancelled orders.","+      A returned order counts as an order, but its net value is 0.","+      A customer without orders gets 0 (not NULL).","+    model: dim_customers","+    given:","+      - input: ref('stg_shopflow_app__customers')","+        rows:","+          - {customer_id: 1, email: lina@example.com, country_code: MA}","+          - {customer_id: 2, email: null, country_code: FR}","+      - input: ref('country_regions')","+        rows:","+          - {country_code: MA, country_name: Morocco, region: Africa}","+          - {country_code: FR, country_name: France, region: Europe}","+      - input: ref('int_orders__enriched')","+        rows:","+          - {order_id: 10, customer_id: 1, order_at: 2025-09-01 10:00:00, order_status: delivered, net_amount_eur: 120.50}","+          - {order_id: 11, customer_id: 1, order_at: 2025-10-05 18:00:00, order_status: returned, net_amount_eur: 0.00}","+          - {order_id: 12, customer_id: 1, order_at: 2025-11-20 09:00:00, order_status: cancelled, net_amount_eur: 0.00}","+    expect:","+      rows:","+        - {customer_id: 1, region: Africa, first_order_at: 2025-09-01 10:00:00, last_order_at: 2025-10-05 18:00:00, number_of_orders: 2, lifetime_value_eur: 120.50}","+        - {customer_id: 2, region: Europe, first_order_at: null, last_order_at: null, number_of_orders: 0, lifetime_value_eur: 0}"]}],"new_mode":"100644","insertions":25,"deletions":0},{"path":"models/staging/web_analytics/_web_analytics__unit_tests.yml","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":18,"section":"","lines":["+unit_tests:","+  - name: test_duplicate_events_keep_the_first_copy","+    description: When the tracker sends the same event_id twice, staging keeps the copy loaded first.","+    model: stg_web_analytics__events","+    given:","+      - input: source('web_analytics', 'events')","+        format: csv","+        rows: |","+          event_id,session_id,customer_id,event_type,event_timestamp,page,_loaded_at","+          e1,s1,,page_view,2025-12-01 10:00:00,/,2025-12-01 10:20:00","+          e1,s1,,page_view,2025-12-01 10:00:00,/,2025-12-01 10:35:00","+          e2,s1,,add_to_cart,2025-12-01 10:02:00,/cart,2025-12-01 10:21:00","+    expect:","+      format: csv","+      rows: |","+        event_id,event_type,loaded_at","+        e1,page_view,2025-12-01 10:20:00","+        e2,add_to_cart,2025-12-01 10:21:00"]}],"new_mode":"100644","insertions":18,"deletions":0}]}
