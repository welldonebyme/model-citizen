{"schema":1,"repo":"shopflow_dbt","from":"m09","to":"m10","from_commit":"6c2e8ff11eab8ca3b8e7a508fc67596d7b37d139","to_commit":"33864ff1442f3324a286c44e86bab8c1d5e5452f","commits":[{"commit":"33864ff1442f3324a286c44e86bab8c1d5e5452f","short":"33864ff","subject":"m10: Python model customer_rfm (pandas RFM segmentation)"}],"stats":{"files_changed":2,"added":1,"removed":0,"modified":1,"insertions":71,"deletions":0},"files":[{"path":"models/marts/marketing/_marketing__models.yml","status":"modified","binary":false,"hunks":[{"old_start":8,"old_lines":6,"new_start":8,"new_lines":24,"section":"models:","lines":["         data_tests: [not_null]","       - name: lifetime_value_eur","         data_tests: [not_negative]","+  - name: customer_rfm","+    description: >","+      Python model. One row per customer who placed at least one non-cancelled order,","+      with RFM scores (1-5) and a segment name.","+    columns:","+      - name: customer_id","+        data_tests:","+          - unique","+          - not_null","+          - relationships:","+              arguments:","+                to: ref('dim_customers')","+                field: customer_id","+      - name: rfm_segment","+        data_tests:","+          - accepted_values:","+              arguments:","+                values: ['champion', 'loyal', 'new_or_returning', 'at_risk', 'hibernating', 'potential']","   - name: fct_events","     description: >","       One row per deduplicated web event. Microbatch incremental model (one batch per day,"]}],"insertions":18,"deletions":0},{"path":"models/marts/marketing/customer_rfm.py","status":"added","binary":false,"hunks":[{"old_start":0,"old_lines":0,"new_start":1,"new_lines":53,"section":"","lines":["+\"\"\"RFM segmentation of ShopFlow customers (Recency, Frequency, Monetary).","+","+Each score goes from 1 (worst) to 5 (best), using quintiles (5 groups of equal size).","+The reference date is the day after the most recent order in the data, so the result","+does not change with the day you run it.","+\"\"\"","+import pandas as pd","+","+","+def segment(row):","+    if row[\"r_score\"] >= 4 and row[\"f_score\"] >= 4:","+        return \"champion\"","+    if row[\"f_score\"] >= 4:","+        return \"loyal\"","+    if row[\"r_score\"] >= 4 and row[\"f_score\"] <= 2:","+        return \"new_or_returning\"","+    if row[\"r_score\"] <= 2 and row[\"f_score\"] >= 3:","+        return \"at_risk\"","+    if row[\"r_score\"] <= 2:","+        return \"hibernating\"","+    return \"potential\"","+","+","+def model(dbt, session):","+    dbt.config(materialized=\"table\")","+","+    # dbt.ref() returns a DuckDB relation on dbt-duckdb: .df() turns it into a pandas DataFrame","+    orders = dbt.ref(\"fct_orders\").df()","+    customers = dbt.ref(\"dim_customers\").df()","+","+    orders = orders[orders[\"order_status\"] != \"cancelled\"].copy()","+    orders[\"net_amount_eur\"] = orders[\"net_amount_eur\"].astype(float)","+    reference_date = orders[\"order_at\"].max().normalize() + pd.Timedelta(days=1)","+","+    rfm = (","+        orders.groupby(\"customer_id\")","+        .agg(last_order_at=(\"order_at\", \"max\"),","+             frequency=(\"order_id\", \"count\"),","+             monetary_eur=(\"net_amount_eur\", \"sum\"))","+        .reset_index()","+    )","+    rfm = rfm[rfm[\"customer_id\"].isin(customers[\"customer_id\"])]   # drops the orphan order","+","+    rfm[\"recency_days\"] = (reference_date - rfm[\"last_order_at\"]).dt.days","+    # rank(method=\"first\") breaks ties, so qcut always finds 5 groups","+    rfm[\"r_score\"] = pd.qcut(rfm[\"recency_days\"].rank(method=\"first\"), 5, labels=[5, 4, 3, 2, 1]).astype(int)","+    rfm[\"f_score\"] = pd.qcut(rfm[\"frequency\"].rank(method=\"first\"), 5, labels=[1, 2, 3, 4, 5]).astype(int)","+    rfm[\"m_score\"] = pd.qcut(rfm[\"monetary_eur\"].rank(method=\"first\"), 5, labels=[1, 2, 3, 4, 5]).astype(int)","+    rfm[\"rfm_segment\"] = rfm.apply(segment, axis=1)","+    rfm[\"monetary_eur\"] = rfm[\"monetary_eur\"].round(2)","+","+    return rfm[[\"customer_id\", \"recency_days\", \"frequency\", \"monetary_eur\",","+                \"r_score\", \"f_score\", \"m_score\", \"rfm_segment\"]]"]}],"new_mode":"100644","insertions":53,"deletions":0}]}
