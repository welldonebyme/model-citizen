---
import type { Block, Cell } from '../../lib/content-types';
import Inline from './Inline.astro';
import CodeBlock from './CodeBlock.astro';
import Callout from './Callout.astro';

interface Props { blocks: Block[] | undefined; /** inside a lab: ordered lists become checkable steps */ inLab?: boolean }
const { blocks = [], inLab = false } = Astro.props;

// Figures are inlined so their colours follow the theme (CSS variables do not reach <img> SVGs).
const FIGS = import.meta.glob('../../generated/figures/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const figSvg = (id: string) => FIGS[`../../generated/figures/${id}.svg`];

const isBlocks = (c: Cell['c']): c is Block[] => {
  const f = Array.isArray(c) ? (c[0] as unknown) : undefined;
  if (!f || typeof f !== 'object') return false;
  const t = (f as { t?: string }).t;
  return t === 'p' || t === 'list' || t === 'table' || t === 'callout' || t === 'h' || (t === 'code' && 'lang' in (f as object));
};
// Code blocks followed by their "Result" block can be sent to a workspace by lab pages.
const runnableIds = new Set(blocks.filter((b) => b.t === 'code' && b.expected).map((b) => (b as { id: string }).id));
---
{blocks.map((b) => {
  switch (b.t) {
    case 'p': return <p><Inline c={b.c} /></p>;
    case 'h': return b.level === 3
      ? <h3 class="bh" id={b.anchor}><Inline c={b.c} /></h3>
      : <h4 class="bh" id={b.anchor}><Inline c={b.c} /></h4>;
    case 'hr': return <hr />;
    case 'list':
      if (b.kind === 'dl') return (
        <dl class="dl">{b.items.map((it) => (<><dt><Inline c={it.term} /></dt><dd><Astro.self blocks={it.blocks} /></dd></>))}</dl>
      );
      if (b.kind === 'ol' && inLab) return (
        <ol class="steps" start={b.start}>
          {b.items.map((it, i) => (
            <li class="step">
              <label class="tick"><input type="checkbox" data-lab-step={String(i + 1)} /><span class="visually-hidden">Step {i + 1} done</span></label>
              <div class="step-body"><Astro.self blocks={it.blocks} /></div>
            </li>
          ))}
        </ol>
      );
      return b.kind === 'ol'
        ? <ol class="ol" start={b.start}>{b.items.map((it) => <li><Astro.self blocks={it.blocks} /></li>)}</ol>
        : <ul class="ul">{b.items.map((it) => <li><Astro.self blocks={it.blocks} /></li>)}</ul>;
    case 'code': return <CodeBlock block={b} runnable={runnableIds.has(b.id)} />;
    case 'callout': return <Callout kind={b.kind} title={b.title}><Astro.self blocks={b.blocks} /></Callout>;
    case 'lab': return (
      <section class="lab" id={b.id} data-lab={b.id} aria-labelledby={`${b.id}-t`}>
        <header class="lab-head">
          <span class="lab-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18"><path d="M6.5 2h5M7.5 2v5L3 14.5A1.5 1.5 0 0 0 4.3 16.7h9.4A1.5 1.5 0 0 0 15 14.5L10.5 7V2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M5 12h8" stroke="currentColor" stroke-width="1.7"/></svg></span>
          <div>
            <p class="lab-kicker">Hands-on lab</p>
            <h3 id={`${b.id}-t`}><Inline c={b.title} /></h3>
          </div>
          {b.objectives.length > 0 && <p class="lab-objs">{b.objectives.map((o) => <Inline c={[{ t: 'obj', id: o }]} />)}</p>}
        </header>
        <div class="lab-body"><Astro.self blocks={b.blocks} inLab /></div>
      </section>
    );
    case 'objectives': return (
      <section class="objectives" aria-label="Exam objectives covered">
        <h3>Exam objectives covered</h3>
        <ul>{b.items.map((it) => <li><Inline c={[{ t: 'obj', id: it.id }]} /> <span><Inline c={it.c} /></span></li>)}</ul>
      </section>
    );
    case 'table': return (
      <div class="table-wrap" tabindex="0" role="region" aria-label="Table">
        <table>
          {b.caption && <caption><Inline c={b.caption} /></caption>}
          {b.head && <thead>{b.head.map((r) => <tr>{r.map((cell) => <th colspan={cell.colspan} rowspan={cell.rowspan} class={cell.align ? `al-${cell.align}` : undefined}>{isBlocks(cell.c) ? <Astro.self blocks={cell.c} /> : <Inline c={cell.c as never} />}</th>)}</tr>)}</thead>}
          <tbody>{b.rows.map((r, ri) => (
            <tr class={b.groupRows?.includes(ri) ? 'group' : undefined}>{r.map((cell) => {
              const inner = isBlocks(cell.c) ? <Astro.self blocks={cell.c} /> : <Inline c={cell.c as never} />;
              return cell.header ? <th scope="row" colspan={cell.colspan} rowspan={cell.rowspan}>{inner}</th> : <td colspan={cell.colspan} rowspan={cell.rowspan} class={cell.align ? `al-${cell.align}` : undefined}>{inner}</td>;
            })}</tr>
          ))}</tbody>
        </table>
      </div>
    );
    case 'figure': {
      const svg = figSvg(b.id);
      return (
        <figure class="fig" id={b.id}>
          {svg ? <div class="fig-svg" role="img" aria-label={b.alt} set:html={svg} /> : <div class="fig-missing" role="img" aria-label={b.alt}><p>Figure {b.id}</p><p>{b.alt}</p></div>}
          {b.caption && <figcaption><Inline c={b.caption} /></figcaption>}
        </figure>
      );
    }
    case 'quiz': return null;
    default: return null;
  }
})}

<style>
  p { max-width: var(--measure); }
  .bh { margin: var(--s7) 0 var(--s3); }
  h4.bh { margin-top: var(--s6); }
  .ul, .ol { padding-left: 1.4em; margin: 0 0 var(--s4); max-width: var(--measure); }
  .ul li, .ol li { margin: 0.25em 0; }
  .ul li :global(p), .ol li :global(p) { margin-bottom: 0.35em; }
  .ul li::marker { color: var(--muted); }
  .ol li::marker { color: var(--muted); font-weight: 700; }
  .dl { margin: 0 0 var(--s4); max-width: var(--measure); }
  .dl dt { font-weight: 700; color: var(--ink); margin-top: var(--s3); }
  .dl dd { margin: 0 0 0 1.2em; }

  .lab { margin: var(--s7) 0; border: 1px solid var(--lab-line); border-radius: var(--r-card); background: var(--surface); overflow: hidden; }
  .lab-head { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; align-items: center; padding: 14px 18px; background: var(--lab-bg); }
  .lab-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: var(--lab); color: var(--surface); }
  .lab-kicker { margin: 0; font-size: var(--fs-xs); font-weight: 700; color: var(--lab); }
  .lab-head h3 { font-size: var(--fs-lg); }
  .lab-objs { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 0; }
  .lab-body { padding: 16px 20px 6px; }
  .steps { list-style: none; counter-reset: st; padding: 0; margin: 0 0 var(--s4); }
  .step { counter-increment: st; display: grid; grid-template-columns: 36px 1fr; gap: 10px; padding: 10px 0; border-top: 1px dashed var(--line); }
  .step:first-child { border-top: 0; }
  .tick { position: relative; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; border: 1.5px solid var(--line-strong); background: var(--surface); cursor: pointer; margin-top: 2px; }
  .tick::before { content: counter(st); font-weight: 700; font-size: var(--fs-sm); color: var(--muted); }
  .tick input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .tick:has(input:checked) { background: var(--lab); border-color: var(--lab); }
  .tick:has(input:checked)::before { content: "✓"; color: var(--surface); }
  .tick:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  .step-body > :global(:first-child) { margin-top: 0; }
  .step-body :global(p:last-child) { margin-bottom: 0; }

  .objectives { margin: 0 0 var(--s6); padding: 16px 18px; border-radius: var(--r-card); background: var(--exam-bg); }
  .objectives h3 { font-size: var(--fs-md); margin-bottom: 8px; }
  .objectives ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .objectives li { display: grid; grid-template-columns: 5.4em 1fr; gap: 8px; align-items: baseline; font-size: var(--fs-md); }
  .objectives li > :global(.obj) { justify-self: start; }

  .table-wrap { margin: var(--s5) 0; overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  table { border-collapse: collapse; width: 100%; font-size: var(--fs-md); line-height: 1.5; }
  caption { caption-side: bottom; text-align: left; padding: 8px 14px; color: var(--muted); font-size: var(--fs-sm); }
  th, td { padding: 9px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  thead th { font-size: var(--fs-sm); color: var(--muted); font-weight: 700; background: var(--surface-2); }
  tbody tr:last-child > * { border-bottom: 0; }
  tr.group > * { background: var(--accent-soft); color: var(--accent-strong); font-weight: 700; }
  th :global(p), td :global(p) { margin: 0 0 4px; }
  .al-c { text-align: center; } .al-r { text-align: right; }

  .fig { margin: var(--s6) 0; }
  .fig-svg { display: flex; justify-content: center; padding: 14px; background: var(--fig-paper); border: 1px solid var(--line); border-radius: 12px; overflow-x: auto; }
  .fig-svg :global(svg) { max-width: 100%; height: auto; }
  .fig-missing { padding: 18px; border: 1px dashed var(--line-strong); border-radius: 12px; color: var(--muted); font-size: var(--fs-sm); }
  .fig figcaption { margin-top: 8px; color: var(--muted); font-size: var(--fs-sm); text-align: center; }
</style>
