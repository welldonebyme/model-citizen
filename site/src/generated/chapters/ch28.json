       "c": [
        "Write your answer next to each number. For DOMC questions, write YES or NO for each letter (for example ",
        {
         "t": "code",
         "v": "A-Y B-N C-Y"
        },
        "). For Matching, write pairs (",
        {
         "t": "code",
         "v": "1-C 2-A ..."
        },
        "). For Build list, write the letters in order (",
        {
         "t": "code",
         "v": "B D A C"
        },
        ")."
       ],
       "t": "p"
