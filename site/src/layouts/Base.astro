---
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/400-italic.css';
import '@fontsource/atkinson-hyperlegible-next/500.css';
import '@fontsource/atkinson-hyperlegible-next/700.css';
import '@fontsource/atkinson-hyperlegible-next/800.css';
import '@fontsource/atkinson-hyperlegible-mono/400.css';
import '@fontsource/atkinson-hyperlegible-mono/600.css';
import '../styles/base.css';
import Logo from '../components/ui/Logo.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Which main-nav item is current. */
  section?: 'today' | 'path' | 'labs' | 'exams' | 'practice' | 'reference' | 'progress' | 'none';
  /** 'plain' hides the site chrome (exam mode). */
  chrome?: 'full' | 'plain';
  wide?: boolean;
}
const { title, description = 'A free, unofficial course to prepare the dbt Analytics Engineering Certification (dbt Core 1.11).', section = 'none', chrome = 'full' } = Astro.props;
const fullTitle = title === 'Model Citizen' ? title : `${title} | Model Citizen`;
const nav = [
  { id: 'today', label: 'Today', href: url('') },
  { id: 'path', label: 'Path', href: url('path/') },
  { id: 'labs', label: 'Labs', href: url('labs/') },
  { id: 'exams', label: 'Mock exams', href: url('exams/') },
  { id: 'practice', label: 'Practice', href: url('practice/') },
  { id: 'reference', label: 'Reference', href: url('reference/') },
  { id: 'progress', label: 'Progress', href: url('progress/') },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <script is:inline>
    // Apply saved reader preferences before first paint (per-browser conveniences only).
    (function () {
      try {
        var d = document.documentElement;
        var t = localStorage.getItem('mc:theme'); if (t === 'light' || t === 'dark') d.dataset.theme = t;
        var s = localStorage.getItem('mc:size'); if (s) d.dataset.size = s;
        var o = localStorage.getItem('mc:os'); d.dataset.os = o || (/Windows/i.test(navigator.userAgent) ? 'win' : 'mac');
      } catch (e) {}
    })();
  </script>
  <slot name="head" />
</head>
<body data-chrome={chrome}>
  <a class="skip-link" href="#main">Skip to content</a>
  {chrome === 'full' && (
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={url('')}><Logo /><span>Model Citizen</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="tools">
          <button class="search-btn" type="button" data-search-open aria-label="Search the course (Ctrl K)">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            <span class="label">Search</span><kbd>Ctrl K</kbd>
          </button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch between light and dark mode">
            <svg class="i-sun" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="3.6" fill="currentColor" /><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M9 1.5v2M9 14.5v2M1.5 9h2M14.5 9h2M3.7 3.7l1.4 1.4M12.9 12.9l1.4 1.4M3.7 14.3l1.4-1.4M12.9 5.1l1.4-1.4" /></g></svg>
            <svg class="i-moon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M14.5 11.2A6.3 6.3 0 0 1 6.8 3.5a6.3 6.3 0 1 0 7.7 7.7z" fill="currentColor" /></svg>
          </button>
          <a class="icon-btn" href={url('settings/')} aria-label="Settings and progress file">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="6" cy="5" r="1.8" fill="var(--surface)" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="9" r="1.8" fill="var(--surface)" stroke="currentColor" stroke-width="1.6" /><circle cx="7.5" cy="13" r="1.8" fill="var(--surface)" stroke="currentColor" stroke-width="1.6" /></svg>
          </a>
          <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Main" hidden>
        {nav.map((n) => (<a href={n.href} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>))}
        <a href={url('settings/')}>Settings and progress file</a>
      </nav>
    </header>
  )}
  <main id="main" tabindex="-1">
    <slot />
  </main>
  {chrome === 'full' && (
    <footer class="site-footer">
      <div class="wrap foot">
        <p>Unofficial study guide. Not affiliated with or endorsed by dbt Labs. dbt is a trademark of dbt Labs, Inc.</p>
        <p class="links"><a href={url('about/')}>About this site</a><a href={url('settings/')}>Your progress file</a></p>
      </div>
    </footer>
  )}
  <script>
    import '../lib/chrome';
  </script>
</body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 24px; height: var(--header-h); padding-inline: 24px; max-width: 1440px; margin-inline: auto; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 800; font-size: 1.125rem; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; }
  .nav { display: flex; gap: 2px; }
  .nav a, .mobile-nav a { padding: 8px 12px; border-radius: 8px; color: var(--muted); text-decoration: none; font-weight: 500; font-size: 0.9375rem; white-space: nowrap; }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current="page"] { color: var(--ink); background: var(--paper); }
  .tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .search-btn { display: inline-flex; align-items: center; gap: 8px; min-width: 210px; height: 40px; padding: 0 10px 0 12px; border: 1px solid var(--line); border-radius: var(--r-ctl); background: var(--paper); color: var(--muted); font-size: 0.9375rem; }
  .search-btn kbd { margin-left: auto; font-size: 0.75rem; border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; background: var(--surface); }
  .icon-btn { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: var(--r-ctl); border: 1px solid transparent; background: transparent; color: var(--muted); }
  .icon-btn:hover { color: var(--ink); border-color: var(--line); }
  .i-moon { display: none; }
  :global(:root[data-theme="dark"]) .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun { display: none; }
    :global(:root:not([data-theme="light"])) .i-moon { display: block; }
  }
  .menu-btn { display: none; }
  .mobile-nav { display: grid; gap: 2px; padding: 8px 16px 14px; border-top: 1px solid var(--line); }
  .mobile-nav a[aria-current="page"] { color: var(--ink); background: var(--paper); }
  main:focus { outline: none; }
  .site-footer { border-top: 1px solid var(--line); margin-top: var(--s9); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-block: 22px; color: var(--muted); font-size: var(--fs-sm); }
  .foot p { margin: 0; }
  .foot .links { display: flex; gap: 16px; }
  .foot a { color: var(--muted); }
  @media (max-width: 1080px) { .search-btn { min-width: 0; } .search-btn .label, .search-btn kbd { display: none; } }
  @media (max-width: 900px) {
    .nav { display: none; }
    .menu-btn { display: inline-grid; }
    .bar { padding-inline: 16px; gap: 12px; }
  }
  @media (min-width: 901px) { .mobile-nav { display: none !important; } }
</style>
