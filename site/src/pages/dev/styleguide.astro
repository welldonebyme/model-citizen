---
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/content/Blocks.astro';
import { sampleBlocks } from '../../dev/sample';
---
<Base title="Style guide" section="none">
  <div class="wrap sg">
    <h1>Style guide</h1>
    <p class="lead">Every content component, rendered from sample data in the converter's schema.</p>
    <div class="row">
      <button class="btn btn-primary">Continue lesson</button>
      <button class="btn btn-ink">Run</button>
      <button class="btn btn-quiet">I understood this</button>
      <button class="btn btn-quiet btn-small">Reset</button>
      <span class="pill pill-lab">In your browser</span><span class="pill pill-quiz">8 questions</span><span class="pill pill-review">4 cards</span><span class="pill pill-trap">Trap</span>
      <div class="seg" data-os-switch role="group" aria-label="Your computer"><button data-os-value="mac" aria-pressed="true">macOS</button><button data-os-value="win" aria-pressed="false">Windows</button><button data-os-value="wsl" aria-pressed="false">WSL</button></div>
    </div>
    <article class="prose"><Blocks blocks={sampleBlocks} /></article>
  </div>
</Base>
<style>
  .sg { padding-block: 40px; }
  .lead { color: var(--muted); font-size: var(--fs-lg); }
  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 24px 0 32px; }
  .prose { max-width: 760px; }
</style>
