---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { chapters, routes } from '../../lib/content';
import type { Block, Inline } from '../../lib/content-types';
import { existsSync, statSync } from 'node:fs';
import { publicPath } from '../../lib/paths';

const text = (c: Inline[]): string => c.map((n) => (typeof n === 'string' ? n : 'v' in n ? n.v : 'c' in n ? text(n.c) : '')).join('');
type LabRow = { id: string; title: string; chapter: number; lessonId: string; lessonNo: string; chapterId: string; objectives: string[] };
const labs: LabRow[] = [];
const walk = (bs: Block[], ctx: Omit<LabRow, 'id' | 'title' | 'objectives'>) => bs.forEach((b) => {
  if (b.t === 'lab') labs.push({ ...ctx, id: b.id, title: text(b.title), objectives: b.objectives });
  if (b.t === 'callout' || b.t === 'lab') walk(b.blocks, ctx);
  if (b.t === 'list') b.items.forEach((it) => walk(it.blocks, ctx));
});
for (const c of chapters) for (const l of c.lessons) for (const st of l.steps) walk(st.blocks, { chapter: c.number, lessonId: l.id, lessonNo: l.number, chapterId: c.id });
const byChapter = chapters.map((c) => ({ c, labs: labs.filter((x) => x.chapterId === c.id) })).filter((g) => g.labs.length);

const pub = (p: string) => publicPath(p);
const size = (p: string) => (existsSync(pub(p)) ? `${(statSync(pub(p)).size / 1048576).toFixed(1)} MB` : null);
const kit = size('kits/dbt-course-kit.zip');
const capKit = size('kits/shopflow-capstone-kit.zip');
---
<Base title="Labs" section="labs">
  <div class="wrap lb">
    <h1>Labs</h1>
    <p class="lead">You learn dbt by doing. {labs.length || 118} labs follow the book: some run here in your browser, others on your computer with real dbt, exactly like at work.</p>

    <div class="tools">
      <a class="tool panel" href={url('labs/dbt/')}><h2>dbt terminal in your browser</h2><p>Real dbt-core 1.11.16 with DuckDB, running in this page. Pick a chapter and run <code class="mc-ic">dbt build</code> with nothing installed.</p></a>
      <a class="tool panel" href={url('labs/sql/')}><h2>SQL playground</h2><p>The practice database (jaffle_shop and stripe) in your browser. Every SQL example of Chapter 4, with the book's result to compare.</p></a>
      <a class="tool panel" href={url('labs/yaml/')}><h2>YAML playground</h2><p>See at once what dbt and Python read from your YAML, or the exact error with its line. Fix the broken files of Chapters 5 and 22.</p></a>
      <a class="tool panel" href={url('labs/jinja/')}><h2>Jinja playground</h2><p>Write a template, compile it like <code class="mc-ic">dbt compile</code>, then run the SQL it becomes. Loops, macros and whitespace from Chapters 5 and 11.</p></a>
      <a class="tool panel" href={url('labs/selectors/')}><h2>Node selection and lineage</h2><p>Type <code class="mc-ic">--select</code> expressions on the real DAG of the project and see exactly what <code class="mc-ic">dbt ls</code> prints.</p></a>
      <a class="tool panel" href={url('labs/capstone/')}><h2>Capstone: ShopFlow</h2><p>Build a real project on your computer in 15 milestones. A board with every requirement to tick, hints, output checks and the solutions.</p></a>
      <a class="tool panel" href={url('labs/reference/')}><h2>Compare with the reference</h2><p>The reference project at every chapter tag, and what each chapter changed. The capstone solutions stay hidden until you ask.</p></a>
      <div class="tool panel kit">
        <h2>Practice kit for your computer</h2>
        <p>Data, setup scripts for macOS, Windows PowerShell and WSL, the nine bug patches, and the reference project with one git tag per chapter.</p>
        <p class="dl">
          {kit ? <a class="btn btn-primary btn-small" href={url('kits/dbt-course-kit.zip')} download>Download the practice kit ({kit})</a> : <span class="muted">The kit is being prepared.</span>}
          {capKit && <a class="btn btn-quiet btn-small" href={url('kits/shopflow-capstone-kit.zip')} download>Capstone kit ({capKit})</a>}
        </p>
      </div>
    </div>

    <h2 class="all-h">All labs, chapter by chapter</h2>
    {byChapter.length === 0 && <p class="muted">The list of labs appears once the book has been converted.</p>}
    {byChapter.map(({ c, labs: ls }) => (
      <section class="ch" aria-labelledby={`lab-ch-${c.id}`}>
        <h3 id={`lab-ch-${c.id}`}><a href={url(routes.chapter(c))}>Chapter {c.number}. {c.title}</a></h3>
        <ol class="labs">
          {ls.map((l) => (
            <li data-lab-row={l.id}>
              <a href={url(`learn/${l.chapterId}/${l.lessonId}/`) + '#' + l.id}>{l.title}</a>
              <span class="where">lesson {l.lessonNo}</span>
              <span class="objs">{l.objectives.map((o) => <span class="mc-obj">{o}</span>)}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>
<style>
  .lb { padding-block: 40px 16px; }
  .lead { color: var(--muted); font-size: var(--fs-lg); max-width: 70ch; }
  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin: 24px 0 40px; }
  .tool { text-decoration: none; color: var(--text); display: block; }
  a.tool:hover { border-color: var(--ink); }
  .tool h2 { font-size: var(--fs-lg); margin-bottom: 6px; }
  .tool p { margin: 0; color: var(--muted); }
  .kit .dl { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .all-h { margin-bottom: 8px; }
  .ch h3 { font-size: var(--fs-md); margin: 22px 0 6px; }
  .ch h3 a { color: var(--ink); text-decoration: none; }
  .labs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .labs li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; padding: 8px 2px; border-bottom: 1px solid var(--line); }
  .labs a { color: var(--text); font-weight: 600; text-decoration: none; }
  .labs a:hover { text-decoration: underline; }
  .where { color: var(--muted); font-size: var(--fs-sm); }
  .objs { display: inline-flex; gap: 4px; margin-left: auto; }
  .muted { color: var(--muted); }
</style>
