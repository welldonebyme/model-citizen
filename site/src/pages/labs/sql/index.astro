---
import Base from '../../../layouts/Base.astro';
import { CodeBlock } from '../../../components/content/CodeBlock';
import SqlWorkspace from '../../../components/labs/SqlWorkspace';
import SqlExamplesRunner from '../../../components/labs/SqlExamplesRunner';
import { url } from '../../../lib/url';
import { routes } from '../../../lib/content';
import data from '../../../lib/sql/book-sql.json';
import manifest from '../../../lib/sql/data-manifest.json';
import '../../../components/labs/labs.css';

type Ex = (typeof data.examples)[number] & { expectedRaw?: string; expectedId?: string; annotation?: string; setup?: string; columnSubset?: boolean; rowPrefix?: boolean; needsModels?: string[]; expectRowCount?: number };
const examples = data.examples as Ex[];
const primary = examples.filter((e) => e.id === e.codeId);
const derived = examples.filter((e) => e.id !== e.codeId);

// chapter -> lesson -> examples, in book order
type Group = { chapter: string; chapterNumber: number; chapterTitle: string; lessons: { id?: string; number?: string; title?: string; items: Ex[] }[] };
const groups: Group[] = [];
for (const e of primary) {
  let g = groups.find((x) => x.chapter === e.chapter);
  if (!g) { g = { chapter: e.chapter, chapterNumber: e.chapterNumber, chapterTitle: e.chapterTitle, lessons: [] }; groups.push(g); }
  let l = g.lessons.find((x) => x.id === e.lessonId);
  if (!l) { l = { id: e.lessonId, number: e.lessonNumber, title: e.lessonTitle, items: [] }; g.lessons.push(l); }
  l.items.push(e);
}
const lessonHref = (e: { chapter: string; lessonId?: string }) => url(e.lessonId ? routes.lesson({ id: e.lessonId }, e.chapter) : `learn/${e.chapter}/`);
const totalChecks = examples.length;
const mb = (n: number) => `${(n / 1e6).toFixed(1)} MB`;
const engineMb = mb(manifest.wasm.eh.wasm.gzip + manifest.wasm.eh.worker.gzip);
---
<Base title="SQL playground" section="labs" description="Run every SQL example of the book on the practice database, in your browser, and compare with the book's result.">
  <div class="wrap mcl-page sqlp">
    <header class="mcl-page-head">
      <p class="kicker"><a href={url('labs/')}>Labs</a></p>
      <h1>SQL playground</h1>
      <p class="lead">A real DuckDB runs in this page with the practice database (jaffle_shop and stripe), like in Chapter 4. Write your own queries, or run any example of the book and compare your result with the book.</p>
    </header>

    <div class="sqlp-grid">
      <div class="sqlp-work">
        <SqlWorkspace client:load heading="Workspace" description={`DuckDB ${manifest.duckdbVersion.replace(/^v/, '')} in your browser. The first visit downloads about ${engineMb}, later visits use the copy kept by your browser.`} />
      </div>

      <div class="sqlp-list">
        <section class="sqlp-intro panel" aria-labelledby="all-h">
          <h2 id="all-h">Every SQL example of the book</h2>
          <p>{primary.length} examples have a result printed in the book. Click <b>Run in workspace</b> on an example: the workspace runs it and tells you if your result matches the book. Change the query and run it again to learn what each part does.</p>
          <SqlExamplesRunner client:visible total={totalChecks} />
        </section>

        {groups.map((g) => (
          <section class="sqlp-ch" aria-labelledby={`h-${g.chapter}`}>
            <h2 id={`h-${g.chapter}`}>Chapter {g.chapterNumber}. {g.chapterTitle}</h2>
            {g.lessons.map((l) => (
              <section class="sqlp-lesson" aria-labelledby={`h-${l.id ?? g.chapter}`}>
                <h3 id={`h-${l.id ?? g.chapter}`}><a href={lessonHref({ chapter: g.chapter, lessonId: l.id })}>{l.number ? `${l.number} ` : ''}{l.title ?? `Chapter ${g.chapterNumber}`}</a> <span class="count">{l.items.length} {l.items.length === 1 ? 'example' : 'examples'}</span></h3>
                {l.items.map((e) => (
                  <article class="sqlp-ex" data-example={e.codeId}>
                    <p class="sqlp-ex-head">
                      <span class="where">{e.labTitle ? `Lab: ${e.labTitle}` : e.stepTitle}</span>
                      <span class="sqlp-status" data-example-status={e.codeId} aria-live="polite"></span>
                    </p>
                    {e.annotation && <p class="sqlp-note">{e.annotation}</p>}
                    <CodeBlock block={{ t: 'code', id: e.codeId, lang: 'sql', text: e.bookSql, title: e.title }} runnable />
                    {e.expectedId && e.expectedRaw !== undefined && (
                      <details class="sqlp-exp">
                        <summary>The book's result</summary>
                        <CodeBlock block={{ t: 'code', id: e.expectedId, lang: 'output', text: e.expectedRaw }} />
                      </details>
                    )}
                    {e.expectRowCount !== undefined && <p class="sqlp-note">The book shows the dbt log of this test: it fails with {e.expectRowCount} rows.</p>}
                    {derived.filter((d) => d.codeId === e.codeId).map((d) => <p class="sqlp-note">Extra check: {d.annotation}</p>)}
                  </article>
                ))}
              </section>
            ))}
          </section>
        ))}

        <section class="sqlp-skipped panel" aria-labelledby="skip-h">
          <h2 id="skip-h">Examples that need dbt</h2>
          <p>These SQL blocks also have a result in the book, but the result comes from objects that dbt builds on your computer (snapshots, models), or it is a dbt log. Run them in the real-machine labs.</p>
          <ul>
            {data.skipped.map((s) => (
              <li><a href={lessonHref(s)}>Lesson {s.lessonNumber ?? `of chapter ${s.chapterNumber}`}</a>{s.title ? <> (<code>{s.title}</code>)</> : null}: {s.reason}.</li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .kicker { margin: 0 0 6px; font-size: var(--fs-sm); }
  .kicker a { color: var(--muted); text-decoration: none; }
  .kicker a:hover { color: var(--ink); }
  .sqlp-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 520px); gap: 28px; align-items: start; }
  .sqlp-list { grid-column: 1; grid-row: 1; min-width: 0; }
  .sqlp-work { grid-column: 2; grid-row: 1; position: sticky; top: calc(var(--header-h) + 12px); max-height: calc(100vh - var(--header-h) - 24px); overflow-y: auto; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); }
  .sqlp-intro h2, .sqlp-skipped h2 { font-size: var(--fs-lg); margin-bottom: 6px; }
  .sqlp-intro p { color: var(--text); }
  .sqlp-ch > h2 { margin: 36px 0 4px; font-size: var(--fs-xl); }
  .sqlp-lesson > h3 { margin: 24px 0 6px; font-size: var(--fs-md); display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
  .sqlp-lesson > h3 a { color: var(--ink); text-decoration: none; }
  .sqlp-lesson > h3 a:hover { text-decoration: underline; }
  .sqlp-lesson .count { font-size: var(--fs-xs); color: var(--muted); font-weight: 600; }
  .sqlp-ex { padding: 8px 0 4px; border-top: 1px solid var(--line); }
  .sqlp-ex :global(.mc-code) { margin: 6px 0 4px; }
  /* long lines wrap here: a code block that scrolls sideways would need to be focusable (axe scrollable-region-focusable) */
  .sqlp-ex :global(.mc-code-body code) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .sqlp-ex-head { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; margin: 6px 0 0; font-size: var(--fs-sm); }
  .sqlp-ex-head .where { color: var(--muted); }
  .sqlp-status { margin-left: auto; font-size: var(--fs-xs); font-weight: 700; }
  .sqlp-status[data-state="ok"] { color: var(--ok); }
  .sqlp-status[data-state="bad"] { color: var(--bad); }
  .sqlp-status[data-state="running"] { color: var(--muted); }
  .sqlp-note { margin: 4px 0; font-size: var(--fs-sm); color: var(--muted); max-width: 78ch; }
  .sqlp-exp { margin: 0 0 8px; }
  .sqlp-exp > summary { cursor: pointer; font-size: var(--fs-sm); color: var(--accent-strong); font-weight: 700; padding: 4px 0; }
  .sqlp-exp :global(.mc-code) { margin-top: 4px; }
  .sqlp-skipped { margin-top: 40px; }
  .sqlp-skipped ul { margin: 0; padding-left: 1.2em; }
  .sqlp-skipped li { margin: 6px 0; font-size: var(--fs-md); }
  :global(.mcl-runner) { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; margin-top: 4px; }
  :global(.mcl-runner-status) { font-size: var(--fs-sm); color: var(--muted); }
  @media (max-width: 1100px) {
    .sqlp-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .sqlp-work { grid-column: 1; grid-row: 1; position: static; max-height: none; }
    .sqlp-list { grid-column: 1; grid-row: 2; }
  }
</style>
