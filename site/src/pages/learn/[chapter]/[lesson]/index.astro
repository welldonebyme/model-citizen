---
import Base from '../../../../layouts/Base.astro';
import { StaticBlocks } from '../../../../components/content/StaticBlocks';
import { Inline } from '../../../../components/content/Inline';
import OsSwitch from '../../../../components/ui/OsSwitch.astro';
import LessonCheckpoints from '../../../../components/quiz/LessonCheckpoints';
import SqlWorkspace from '../../../../components/labs/SqlWorkspace';
import DbtWorkspace from '../../../../components/dbt/DbtWorkspace';
import { dbtCommands } from '../../../../components/content/CodeBlock';
import sqlMeta from '../../../../lib/sql/book-sql-meta.json';
import { lessons, neighbours, routes, partName } from '../../../../lib/content';
import { figuresFor } from '../../../../lib/figures';
import { url } from '../../../../lib/url';
import type { Block } from '../../../../lib/content-types';

export function getStaticPaths() {
  return lessons.map((r) => ({ params: { chapter: r.chapter.id, lesson: r.lesson.id }, props: { id: r.lesson.id } }));
}
const { id } = Astro.props;
const ref = lessons.find((r) => r.lesson.id === id)!;
const { chapter, lesson } = ref;
const { prev, next } = neighbours(id);
const allBlocks: Block[] = lesson.steps.flatMap((s) => s.blocks);
const figures = figuresFor(allBlocks);
const steps = lesson.steps;
const isLast = !next || next.chapter.id !== chapter.id;
// The SQL workspace (DuckDB in the browser) sits in a right column when the lesson has book SQL it can run.
const codeIds: string[] = [];
const dbtLines: string[] = [];
const walkCode = (bs: Block[]) => bs.forEach((b) => {
  if (b.t === 'code') { codeIds.push(b.id); if (b.lang === 'bash') dbtLines.push(...dbtCommands(b.text)); }
  if (b.t === 'callout' || b.t === 'lab') walkCode(b.blocks);
  if (b.t === 'list') b.items.forEach((it) => walkCode(it.blocks));
});
walkCode(allBlocks);
// The dbt workspace (real dbt in the browser) on every lesson of Chapters 6 to 25 with a lab or a dbt command,
// starting from the chapter's start state, and on the capstone milestones 26.2 to 26.16 (m00 to m14).
// Labs without any dbt command do not need it (ch13-lab3/4, ch19-lab4, ch25-lab1/3).
const NO_DBT_LABS = new Set(['ch13-lab3', 'ch13-lab4', 'ch19-lab4', 'ch25-lab1', 'ch25-lab3']);
const milestone = chapter.id === 'ch26' ? lesson.titleText.match(/^Milestone (m\d\d) /)?.[1] : undefined;
const dbtPreset = milestone ? `${milestone}-start`
  : chapter.number >= 6 && chapter.number <= 25 && (dbtLines.length > 0 || lesson.labs.some((l) => !NO_DBT_LABS.has(l))) ? `${chapter.id}-start` : undefined;
const dbtSuggestions = [...new Set(dbtLines)].filter((c) => c.length <= 60).slice(0, 3);
const sqlExamples = dbtPreset ? [] : codeIds.filter((id) => id in (sqlMeta as { examples: Record<string, unknown> }).examples);
const hasWork = !!dbtPreset || sqlExamples.length > 0;
const labHref = lesson.labs[0] ? `${url(routes.lesson(lesson, chapter.id))}#${lesson.labs[0]}` : undefined;
---
<Base title={`${lesson.number} ${lesson.titleText}`} section="path" description={`Lesson ${lesson.number} of the Model Citizen dbt course: ${lesson.titleText}.`}>
  <div class:list={['lessonbar', { 'has-work-bar': hasWork }]}>
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={url(routes.chapter(chapter))}>Chapter {chapter.number}, {chapter.title}</a>
      <span aria-hidden="true">/</span>
      <b>{lesson.number}</b>
    </nav>
    {steps.length > 1 && (
      <ol class="dots" aria-label={`${steps.length} steps`}>
        {steps.map((s, i) => <li><a href={`#${s.id}`} data-step-dot={s.id} title={s.titleText}><span class="visually-hidden">Step {i + 1}: {s.titleText}</span></a></li>)}
      </ol>
    )}
    <span class="bar-tools">
      <button type="button" class="btn btn-quiet btn-small outline-btn" data-outline-toggle aria-expanded="false" aria-controls="lesson-outline">Lessons<span class="visually-hidden"> of chapter {chapter.number}</span></button>
      {hasWork && <a class="btn btn-quiet btn-small work-jump" href="#lesson-work" data-work-jump>Workspace</a>}
    </span>
    <OsSwitch />
    <button type="button" class="btn btn-quiet btn-small focus-btn" data-focus-toggle aria-pressed="false" title="Hide the menus to read (Esc to leave)">Focus</button>
  </div>

  <div class:list={['lesson', { 'has-work': hasWork }]} data-lesson={lesson.id} data-chapter={chapter.id}>
    <nav class="outline" id="lesson-outline" aria-label={`Chapter ${chapter.number} lessons`}>
      <p class="outline-title"><a href={url(routes.chapter(chapter))}>{partName(chapter.part)}, chapter {chapter.number}</a><button type="button" class="outline-close" data-outline-close aria-label="Close the list of lessons">×</button></p>
      <ol>
        {chapter.lessons.map((l) => (
          <li class:list={[{ now: l.id === lesson.id }]} data-outline-lesson={l.id}>
            <a href={url(routes.lesson(l, chapter.id))} aria-current={l.id === lesson.id ? 'page' : undefined}>
              <span class="num">{l.number}</span> <Inline c={l.title} />
            </a>
            {l.labs.length > 0 && <span class="lab-mark">{l.labs.length === 1 ? '1 lab' : `${l.labs.length} labs`}</span>}
          </li>
        ))}
        {chapter.quiz.length > 0 && <li class="quiz-item"><a href={url(routes.quiz(chapter))}>Check yourself <span class="pill pill-quiz">{chapter.quiz.length} questions</span></a></li>}
      </ol>
    </nav>

    <article class="read" data-pagefind-body>
      <header class="lesson-head">
        <p class="kicker" data-pagefind-ignore>Lesson {lesson.number}, about {lesson.minutes} minutes of reading{lesson.labMinutes ? `, ${lesson.labMinutes} minutes of lab` : ''}</p>
        <h1 data-pagefind-meta="title"><Inline c={lesson.title} /></h1>
        <span hidden data-pagefind-ignore data-pagefind-meta="section">Chapter {chapter.number}, {chapter.title}</span>
        {lesson.objectives.length > 0 && (
          <p class="objs" data-pagefind-ignore><span class="visually-hidden">Exam objectives:</span>{lesson.objectives.map((o) => <Inline c={[{ t: 'obj', id: o }]} />)}</p>
        )}
      </header>

      {steps.map((s, i) => (
        <section class="step" id={s.id} data-step={s.id} aria-labelledby={`${s.id}-h`}
          data-hints={s.titleText === 'Hints' ? '' : undefined} data-checkpoint={s.titleText === 'Checkpoint' ? '' : undefined}>
          {s.anchor && <span class="mc-anchor" id={s.anchor} />}
          {i > 0 ? <h2 class="step-h" id={`${s.id}-h`}><span class="step-n" data-pagefind-ignore>Step {i + 1} of {steps.length} </span><Inline c={s.title} /></h2>
                 : <h2 class="visually-hidden" id={`${s.id}-h`} data-pagefind-ignore>Step 1 of {steps.length}: {s.titleText}</h2>}
          <div class="step-body"><StaticBlocks blocks={s.blocks} figures={figures} /></div>
          <footer class="step-foot" data-pagefind-ignore>
            <button type="button" class="btn btn-quiet btn-small" data-understood={s.id} aria-pressed="false">I understood this</button>
            {i < steps.length - 1
              ? <a class="next-step" href={`#${steps[i + 1].id}`}>Next: {steps[i + 1].titleText}</a>
              : <span class="end-note">End of the lesson</span>}
          </footer>
        </section>
      ))}

      {lesson.checkpoints.length > 0 && (
        <section class="checkpoints" aria-label="Check your understanding" data-pagefind-ignore>
          <LessonCheckpoints client:visible chapterId={chapter.id} questionIds={lesson.checkpoints} />
        </section>
      )}

      <nav class="pager" aria-label="Lessons" data-pagefind-ignore>
        {prev ? <a class="pg prev" href={url(routes.lesson(prev.lesson, prev.chapter.id))}><span>Previous lesson</span><b>{prev.lesson.number} {prev.lesson.titleText}</b></a> : <span />}
        {isLast && chapter.quiz.length > 0
          ? <a class="pg next" href={url(routes.quiz(chapter))}><span>End of chapter {chapter.number}</span><b>Check yourself: {chapter.quiz.length} questions</b></a>
          : next && <a class="pg next" href={url(routes.lesson(next.lesson, next.chapter.id))}><span>Next lesson</span><b>{next.lesson.number} {next.lesson.titleText}</b></a>}
      </nav>
    </article>
    {dbtPreset && (
      <aside class="work" id="lesson-work" aria-label="dbt workspace" data-dbt-workspace tabindex="-1">
        <div class="work-in">
          <a class="btn btn-ink btn-small work-back" href="#" data-work-back hidden>Back to the lesson</a>
          <DbtWorkspace client:visible preset={dbtPreset} title={milestone ? `ShopFlow workspace, ${milestone}` : `Chapter ${chapter.number} workspace`} onMachineHref={labHref} suggestions={dbtSuggestions} />
        </div>
      </aside>
    )}
    {sqlExamples.length > 0 && (
      <aside class="work" id="lesson-work" aria-label="SQL workspace" data-sql-workspace tabindex="-1">
        <div class="work-in">
          <a class="btn btn-ink btn-small work-back" href="#" data-work-back hidden>Back to the lesson</a>
          <div class="work-sql"><SqlWorkspace client:idle autostart={false} heading="Try it here" description={`The practice database runs in your browser. Press "Run in workspace" on any example of this lesson, or write your own query.`} initialCodeId={sqlExamples[0]} /></div>
        </div>
      </aside>
    )}
  </div>
  <script>
    import '../../../../lib/lesson-progress';
    import '../../../../lib/verify/ui';
    import '../../../../lib/hints';
    // Focus mode: only the lesson (and its workspace) on screen; remembered in this browser, Esc leaves it
    const root = document.documentElement;
    const focusBtn = document.querySelector<HTMLButtonElement>('[data-focus-toggle]');
    const setFocus = (on: boolean) => {
      if (on) root.dataset.focus = 'on'; else delete root.dataset.focus;
      focusBtn?.setAttribute('aria-pressed', String(on));
      try { if (on) localStorage.setItem('mc:focus', 'on'); else localStorage.removeItem('mc:focus'); } catch { /* not saved */ }
    };
    let saved = false;
    try { saved = localStorage.getItem('mc:focus') === 'on'; } catch { /* storage blocked */ }
    setFocus(saved);
    focusBtn?.addEventListener('click', () => setFocus(root.dataset.focus !== 'on'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.dataset.focus === 'on' && !(e.target as HTMLElement).closest('input, textarea, [contenteditable], .cm-editor, dialog')) setFocus(false); });
    // "Run in workspace" only where a SQL workspace is on the page
    if (!document.querySelector('[data-sql-workspace]')) document.querySelectorAll('[data-send-to-workspace]').forEach((b) => b.remove());

    // The chapter's lessons as a drawer ("Lessons" in the lesson bar) when the outline column does not fit
    const lessonEl = document.querySelector<HTMLElement>('.lesson');
    const outlineBtn = document.querySelector<HTMLButtonElement>('[data-outline-toggle]');
    const outline = document.getElementById('lesson-outline');
    const setOutline = (open: boolean, refocus = false) => {
      if (!lessonEl || !outlineBtn) return;
      if (open) lessonEl.dataset.outlineOpen = ''; else delete lessonEl.dataset.outlineOpen;
      outlineBtn.setAttribute('aria-expanded', String(open));
      if (open) (outline?.querySelector<HTMLElement>('[aria-current="page"]') ?? outline?.querySelector<HTMLElement>('a'))?.focus();
      else if (refocus) outlineBtn.focus();
    };
    outlineBtn?.addEventListener('click', () => setOutline(lessonEl?.dataset.outlineOpen === undefined));
    document.querySelector('[data-outline-close]')?.addEventListener('click', () => setOutline(false, true));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lessonEl?.dataset.outlineOpen !== undefined) setOutline(false, true); });
    document.addEventListener('pointerdown', (e) => {
      const t = e.target as Element;
      if (lessonEl?.dataset.outlineOpen !== undefined && !outline?.contains(t) && !outlineBtn?.contains(t)) setOutline(false);
    });
    window.addEventListener('resize', () => { if (outlineBtn && !outlineBtn.offsetParent) setOutline(false); });
    // Tab past the last lesson closes the drawer (it is not a dialog: the page stays usable)
    outline?.addEventListener('focusout', (e) => {
      const to = e.relatedTarget as Node | null;
      if (lessonEl?.dataset.outlineOpen !== undefined && to && !outline.contains(to) && to !== outlineBtn) setOutline(false);
    });

    // Stacked layout (the workspace below the lesson): a jump to the workspace leaves a way back to the same place
    const work = document.querySelector<HTMLElement>('#lesson-work');
    const back = work?.querySelector<HTMLAnchorElement>('[data-work-back]');
    const stepEls = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
    const stacked = matchMedia('(max-width: 1080px)');
    let returnTo: { y: number; el: HTMLElement } | null = null;
    document.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-send-to-workspace], [data-dbt-try], [data-work-jump]');
      if (!b || !back || !work || work.contains(b) || !stacked.matches) return;
      const step = b.closest<HTMLElement>('[data-step]');
      const i = step ? stepEls.indexOf(step) : -1;
      returnTo = { y: window.scrollY, el: b };
      back.textContent = i >= 0 ? `Back to step ${i + 1}: ${step!.querySelector('h2')?.textContent?.replace(/^Step \d+ of \d+:?\s*/, '') ?? ''}` : 'Back to the lesson';
      back.hidden = false;
    }, true);
    back?.addEventListener('click', (e) => {
      e.preventDefault();
      if (!returnTo) return;
      const { y, el } = returnTo;
      window.scrollTo({ top: y, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      el.focus({ preventScroll: true });
      back.hidden = true;
      returnTo = null;
    });
    document.querySelector('[data-work-jump]')?.addEventListener('click', (e) => {
      e.preventDefault();
      work?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      work?.focus({ preventScroll: true });
    });
  </script>
</Base>

<style>
  .lessonbar { position: sticky; top: var(--header-h); z-index: 30; display: flex; align-items: center; gap: 12px 20px; min-height: 52px; padding: 6px 24px; background: var(--surface); border-bottom: 1px solid var(--line); font-size: var(--fs-sm); }
  .crumb { display: flex; gap: 8px; align-items: baseline; color: var(--muted); min-width: 0; margin-right: auto; }
  .crumb a { color: var(--muted); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .crumb a:hover { color: var(--ink); }
  .crumb b { color: var(--ink); white-space: nowrap; }
  /* step dots: a 6 px bar in a 26 x 24 px target (WCAG 2.5.8) */
  .dots { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .dots a { display: flex; align-items: center; width: 26px; height: 24px; }
  .dots a::before { content: ""; width: 100%; height: 6px; border-radius: 3px; background: var(--line); }
  .dots a:hover::before { background: var(--line-strong); }
  .dots a[data-state="seen"]::before { background: var(--line-strong); }
  .dots a[data-state="understood"]::before { background: var(--ink); }
  .dots a[data-current]::before { background: var(--accent); }
  .bar-tools { display: flex; gap: 8px; }
  .outline-btn, .work-jump { display: none; flex: none; }
  .focus-btn { flex: none; }
  /* focus mode (computers and tablets): the site menu, the outline and the footer step aside */
  @media (min-width: 701px) {
    :global(:root[data-focus="on"] .site-header nav), :global(:root[data-focus="on"] .site-footer) { display: none; }
    :global(:root[data-focus="on"]) .lesson:not([data-outline-open]) .outline { display: none; }
    :global(:root[data-focus="on"]) .outline-btn { display: inline-flex; }
    :global(:root[data-focus="on"]) .lesson { grid-template-columns: minmax(0, 1fr); max-width: 980px; }
    :global(:root[data-focus="on"]) .lesson.has-work { grid-template-columns: minmax(0, 1fr) minmax(380px, 460px); max-width: 1500px; }
  }
  @media (min-width: 701px) and (max-width: 1080px) { :global(:root[data-focus="on"]) .lesson.has-work { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 700px) { .focus-btn { display: none; } }

  .lesson { display: grid; grid-template-columns: 260px minmax(0, 1fr); max-width: 1320px; margin-inline: auto; }
  .outline { position: sticky; top: calc(var(--header-h) + 52px); align-self: start; max-height: calc(100vh - var(--header-h) - 52px); overflow-y: auto; padding: 24px 18px 40px; border-right: 1px solid var(--line); }
  .outline-title { display: flex; align-items: center; gap: 8px; margin: 0 0 14px; font-size: var(--fs-sm); font-weight: 600; }
  .outline-title a { color: var(--muted); text-decoration: none; }
  .outline-close { display: none; place-items: center; flex: none; width: 36px; height: 36px; margin-left: auto; border: 1px solid var(--line); border-radius: var(--r-ctl); background: var(--surface); color: var(--ink); font-size: 1.25rem; line-height: 1; }
  .outline ol { list-style: none; margin: 0; padding: 0; position: relative; }
  .outline ol::before { content: ""; position: absolute; left: 7px; top: 12px; bottom: 12px; width: 2px; background: var(--line); }
  .outline li { position: relative; padding: 6px 0 6px 26px; font-size: var(--fs-sm); line-height: 1.35; }
  .outline li::before { content: ""; position: absolute; left: 1px; top: 10px; width: 10px; height: 10px; border-radius: 3px; border: 2px solid var(--line-strong); background: var(--paper); }
  .outline li[data-state="done"]::before { background: var(--ink); border-color: var(--ink); }
  .outline li.now::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .outline a { color: var(--muted); text-decoration: none; }
  .outline a:hover { color: var(--ink); }
  .outline li[data-state="done"] > a { color: var(--text); }
  .outline li.now > a { color: var(--ink); font-weight: 700; }
  .outline .num { font-variant-numeric: tabular-nums; }
  .lab-mark { display: block; font-size: var(--fs-xs); color: var(--lab); font-weight: 600; margin-top: 2px; }
  .quiz-item { margin-top: 6px; }

  .read { min-width: 0; padding: 36px 48px 64px; container-type: inline-size; }
  /* a figure whose text would stay small in the 780 px text column may use the whole reading column */
  @media (min-width: 701px) {
    .step-body > :global(.mc-fig) { width: max(100%, min(calc(var(--fig-max, 0px) + 30px), 100cqw)); }
  }
  .lesson-head { max-width: var(--measure); margin-bottom: 8px; }
  .kicker { color: var(--muted); font-size: var(--fs-md); margin: 0 0 6px; display: flex; align-items: center; gap: 10px; }
  .lesson-head h1 { font-size: var(--fs-3xl); }
  .objs { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }

  .step { max-width: 780px; padding: 8px 0 4px; scroll-margin-top: calc(var(--header-h) + 64px); }
  .step + .step { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--line); }
  .step-h { display: grid; gap: 4px; font-size: var(--fs-2xl); margin: 0 0 14px; }
  .step-n { font-size: var(--fs-sm); font-weight: 600; color: var(--muted); letter-spacing: 0; }
  .step-body { font-size: var(--fs-body); }
  .step-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 22px; }
  .next-step { font-weight: 700; color: var(--accent-strong); text-decoration: none; }
  .next-step::after { content: " ↓"; }
  .end-note { color: var(--muted); font-size: var(--fs-sm); }

  .checkpoints { max-width: 780px; margin-top: 40px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 780px; margin-top: 48px; }
  .pg { display: grid; gap: 2px; padding: 14px 18px; border: 1px solid var(--line); border-radius: var(--r-card); background: var(--surface); text-decoration: none; color: var(--text); }
  .pg span { font-size: var(--fs-sm); color: var(--muted); }
  .pg b { color: var(--ink); }
  .pg.next { text-align: right; border-color: var(--accent); }
  .pg:hover { box-shadow: var(--shadow); }

  /* lessons with a workspace: outline | reading | workspace from 1281 px (a narrower outline and workspace up to
     1599 px), then reading | workspace with the outline in the drawer, then the workspace below the lesson */
  .lesson.has-work { grid-template-columns: 240px minmax(0, 1fr) minmax(400px, 480px); max-width: 1720px; }
  .work { min-width: 0; border-left: 1px solid var(--line); background: var(--surface-2); }
  .work:focus { outline: none; }
  .work-in { position: sticky; top: calc(var(--header-h) + 52px); max-height: calc(100vh - var(--header-h) - 52px); overflow-y: auto; padding: 20px 18px 28px; }
  /* the SQL workspace in the same card as the dbt workspace (components/dbt/dbt.css .dbt-ws) */
  .work-sql { border: 1px solid var(--line); border-radius: var(--r-card); background: var(--surface); }
  .work-sql :global(.mcl) { border-radius: calc(var(--r-card) - 1px); }
  .work-back { position: sticky; top: calc(var(--header-h) + 8px); z-index: 5; margin-bottom: 12px; max-width: 100%; white-space: normal; text-align: left; box-shadow: var(--shadow); }
  @media (max-width: 1599px) {
    .lesson.has-work { grid-template-columns: 220px minmax(0, 1fr) minmax(360px, 420px); }
    .lesson.has-work .read { padding-inline: 32px; }
  }
  @media (max-width: 1280px) {
    .lesson.has-work { grid-template-columns: minmax(0, 1fr) minmax(360px, 420px); }
    .lesson.has-work .outline { display: none; }
    .has-work-bar .outline-btn { display: inline-flex; }
  }
  @media (max-width: 1080px) {
    .lesson.has-work { grid-template-columns: minmax(0, 1fr); }
    .work { border-left: 0; border-top: 1px solid var(--line); scroll-margin-top: var(--header-h); }
    .work-in { position: static; max-height: none; padding: 24px; }
    .lesson { grid-template-columns: minmax(0, 1fr); }
    .outline { display: none; }
    .outline-btn, .work-jump { display: inline-flex; }
    .read, .lesson.has-work .read { padding: 28px 24px 48px; }
  }
  @media (max-width: 700px) {
    /* two rows: the breadcrumb and "Lessons", then the OS switch and "Workspace" */
    .lessonbar { position: static; padding: 6px 16px; gap: 8px 10px; flex-wrap: wrap; }
    .crumb { flex: 1 1 180px; }
    .bar-tools { display: contents; }
    .lessonbar :global(.seg) { order: 2; }
    .work-jump { order: 3; }
    .dots { display: none; }
    .read, .lesson.has-work .read { padding: 22px 16px 40px; }
    .work-in { padding: 20px 16px; }
    .lesson-head h1 { font-size: var(--fs-2xl); }
    .step-h { font-size: var(--fs-xl); }
    .pager { grid-template-columns: 1fr; }
    .pg.next { text-align: left; }
  }
  /* the outline as a drawer, opened with "Lessons" in the lesson bar when its column does not fit (after the
     media queries: it wins over their display: none) */
