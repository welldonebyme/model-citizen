---
import Base from '../../../../layouts/Base.astro';
import { StaticBlocks } from '../../../../components/content/StaticBlocks';
import { Inline } from '../../../../components/content/Inline';
import OsSwitch from '../../../../components/ui/OsSwitch.astro';
import { lessons, neighbours, routes, partName } from '../../../../lib/content';
import { figuresFor } from '../../../../lib/figures';
import { url } from '../../../../lib/url';
import type { Block } from '../../../../lib/content-types';

export function getStaticPaths() {
  return lessons.map((r) => ({ params: { chapter: r.chapter.id, lesson: r.lesson.id }, props: { id: r.lesson.id } }));
}
const { id } = Astro.props;
const ref = lessons.find((r) => r.lesson.id === id)!;
const { chapter, lesson } = ref;
const { prev, next } = neighbours(id);
const allBlocks: Block[] = lesson.steps.flatMap((s) => s.blocks);
const figures = figuresFor(allBlocks);
const steps = lesson.steps;
const isLast = !next || next.chapter.id !== chapter.id;
---
<Base title={`${lesson.number} ${lesson.titleText}`} section="path" description={`Lesson ${lesson.number} of the Model Citizen dbt course: ${lesson.titleText}.`}>
  <div class="lessonbar">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href={url(routes.chapter(chapter))}>Chapter {chapter.number}, {chapter.title}</a>
      <span aria-hidden="true">/</span>
      <b>{lesson.number}</b>
    </nav>
    {steps.length > 1 && (
      <ol class="dots" aria-label={`${steps.length} steps`}>
        {steps.map((s, i) => <li><a href={`#${s.id}`} data-step-dot={s.id} title={s.titleText}><span class="visually-hidden">Step {i + 1}: {s.titleText}</span></a></li>)}
      </ol>
    )}
    <OsSwitch />
  </div>

  <div class="lesson" data-lesson={lesson.id} data-chapter={chapter.id}>
    <nav class="outline" aria-label={`Chapter ${chapter.number} lessons`}>
      <p class="outline-title"><a href={url(routes.chapter(chapter))}>{partName(chapter.part)}, chapter {chapter.number}</a></p>
      <ol>
        {chapter.lessons.map((l) => (
          <li class:list={[{ now: l.id === lesson.id }]} data-outline-lesson={l.id}>
            <a href={url(routes.lesson(l, chapter.id))} aria-current={l.id === lesson.id ? 'page' : undefined}>
              <span class="num">{l.number}</span> <Inline c={l.title} />
            </a>
            {l.labs.length > 0 && <span class="lab-mark">{l.labs.length === 1 ? '1 lab' : `${l.labs.length} labs`}</span>}
          </li>
        ))}
        {chapter.quiz.length > 0 && <li class="quiz-item"><a href={url(routes.quiz(chapter))}>Check yourself <span class="pill pill-quiz">{chapter.quiz.length} questions</span></a></li>}
      </ol>
    </nav>

    <article class="read" data-pagefind-body>
      <header class="lesson-head">
        <p class="kicker">Lesson {lesson.number}, about {lesson.minutes} minutes</p>
        <h1 data-pagefind-meta="title"><Inline c={lesson.title} /></h1>
        <span hidden data-pagefind-meta="section">Chapter {chapter.number}, {chapter.title}</span>
        {lesson.objectives.length > 0 && (
          <p class="objs"><span class="visually-hidden">Exam objectives:</span>{lesson.objectives.map((o) => <Inline c={[{ t: 'obj', id: o }]} />)}</p>
        )}
      </header>

      {steps.map((s, i) => (
        <section class="step" id={s.id} data-step={s.id} aria-labelledby={`${s.id}-h`}>
          {i > 0 ? <h2 class="step-h" id={`${s.id}-h`}><span class="step-n">Step {i + 1} of {steps.length}</span><Inline c={s.title} /></h2>
                 : <h2 class="visually-hidden" id={`${s.id}-h`}>Step 1 of {steps.length}: {s.titleText}</h2>}
          <div class="step-body"><StaticBlocks blocks={s.blocks} figures={figures} /></div>
          <footer class="step-foot">
            <button type="button" class="btn btn-quiet btn-small" data-understood={s.id} aria-pressed="false">I understood this</button>
            {i < steps.length - 1
              ? <a class="next-step" href={`#${steps[i + 1].id}`}>Next: {steps[i + 1].titleText}</a>
              : <span class="end-note">End of the lesson</span>}
          </footer>
        </section>
      ))}

      <nav class="pager" aria-label="Lessons">
        {prev ? <a class="pg prev" href={url(routes.lesson(prev.lesson, prev.chapter.id))}><span>Previous lesson</span><b>{prev.lesson.number} {prev.lesson.titleText}</b></a> : <span />}
        {isLast && chapter.quiz.length > 0
          ? <a class="pg next" href={url(routes.quiz(chapter))}><span>End of chapter {chapter.number}</span><b>Check yourself: {chapter.quiz.length} questions</b></a>
          : next && <a class="pg next" href={url(routes.lesson(next.lesson, next.chapter.id))}><span>Next lesson</span><b>{next.lesson.number} {next.lesson.titleText}</b></a>}
      </nav>
    </article>
  </div>
  <script>
    import '../../../../lib/lesson-progress';
    import '../../../../lib/verify/ui';
  </script>
</Base>

<style>
  .lessonbar { position: sticky; top: var(--header-h); z-index: 30; display: flex; align-items: center; gap: 20px; min-height: 52px; padding: 6px 24px; background: var(--surface); border-bottom: 1px solid var(--line); font-size: var(--fs-sm); }
  .crumb { display: flex; gap: 8px; align-items: baseline; color: var(--muted); min-width: 0; }
  .crumb a { color: var(--muted); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .crumb a:hover { color: var(--ink); }
  .crumb b { color: var(--ink); white-space: nowrap; }
  .dots { display: flex; gap: 6px; list-style: none; margin: 0 0 0 auto; padding: 0; }
  .dots a { display: block; width: 26px; height: 6px; border-radius: 3px; background: var(--line); }
  .dots a[data-state="seen"] { background: var(--line-strong); }
  .dots a[data-state="understood"] { background: var(--ink); }
  .dots a[data-current] { background: var(--accent); }
  .lessonbar :global(.seg) { margin-left: auto; }
  .dots + :global(.seg) { margin-left: 0; }

  .lesson { display: grid; grid-template-columns: 260px minmax(0, 1fr); max-width: 1320px; margin-inline: auto; }
  .outline { position: sticky; top: calc(var(--header-h) + 52px); align-self: start; max-height: calc(100vh - var(--header-h) - 52px); overflow-y: auto; padding: 24px 18px 40px; border-right: 1px solid var(--line); }
  .outline-title { margin: 0 0 14px; font-size: var(--fs-sm); font-weight: 600; }
  .outline-title a { color: var(--muted); text-decoration: none; }
  .outline ol { list-style: none; margin: 0; padding: 0; position: relative; }
  .outline ol::before { content: ""; position: absolute; left: 7px; top: 12px; bottom: 12px; width: 2px; background: var(--line); }
  .outline li { position: relative; padding: 6px 0 6px 26px; font-size: var(--fs-sm); line-height: 1.35; }
  .outline li::before { content: ""; position: absolute; left: 1px; top: 10px; width: 10px; height: 10px; border-radius: 3px; border: 2px solid var(--line-strong); background: var(--paper); }
  .outline li[data-state="done"]::before { background: var(--ink); border-color: var(--ink); }
  .outline li.now::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .outline a { color: var(--muted); text-decoration: none; }
  .outline a:hover { color: var(--ink); }
  .outline li[data-state="done"] > a { color: var(--text); }
  .outline li.now > a { color: var(--ink); font-weight: 700; }
  .outline .num { font-variant-numeric: tabular-nums; }
  .lab-mark { display: block; font-size: var(--fs-xs); color: var(--lab); font-weight: 600; margin-top: 2px; }
  .quiz-item { margin-top: 6px; }

  .read { min-width: 0; padding: 36px 48px 64px; }
  .lesson-head { max-width: var(--measure); margin-bottom: 8px; }
  .kicker { color: var(--muted); font-size: var(--fs-md); margin: 0 0 6px; display: flex; align-items: center; gap: 10px; }
  .lesson-head h1 { font-size: var(--fs-3xl); }
  .objs { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }

  .step { max-width: 780px; padding: 8px 0 4px; scroll-margin-top: calc(var(--header-h) + 64px); }
  .step + .step { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--line); }
  .step-h { display: grid; gap: 4px; font-size: var(--fs-2xl); margin: 0 0 14px; }
  .step-n { font-size: var(--fs-sm); font-weight: 600; color: var(--muted); letter-spacing: 0; }
  .step-body { font-size: var(--fs-body); }
  .step-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 22px; }
  .next-step { font-weight: 700; color: var(--accent-strong); text-decoration: none; }
  .next-step::after { content: " ↓"; }
  .end-note { color: var(--muted); font-size: var(--fs-sm); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 780px; margin-top: 48px; }
  .pg { display: grid; gap: 2px; padding: 14px 18px; border: 1px solid var(--line); border-radius: var(--r-card); background: var(--surface); text-decoration: none; color: var(--text); }
  .pg span { font-size: var(--fs-sm); color: var(--muted); }
  .pg b { color: var(--ink); }
  .pg.next { text-align: right; border-color: var(--accent); }
  .pg:hover { box-shadow: var(--shadow); }

  @media (max-width: 1080px) {
    .lesson { grid-template-columns: minmax(0, 1fr); }
    .outline { display: none; }
    .read { padding: 28px 24px 48px; }
  }
  @media (max-width: 700px) {
    .lessonbar { position: static; padding: 6px 16px; gap: 10px; flex-wrap: wrap; }
    .dots { display: none; }
    .read { padding: 22px 16px 40px; }
    .lesson-head h1 { font-size: var(--fs-2xl); }
    .step-h { font-size: var(--fs-xl); }
    .pager { grid-template-columns: 1fr; }
    .pg.next { text-align: left; }
  }
</style>
