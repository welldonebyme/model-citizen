---
import Base from '../../../layouts/Base.astro';
import { StaticBlocks } from '../../../components/content/StaticBlocks';
import { Inline } from '../../../components/content/Inline';
import { cheatsheets } from '../../../lib/reference';
import { figuresFor } from '../../../lib/figures';
const sheets = cheatsheets?.lessons ?? [];
---
<Base title="Cheat sheets" section="reference">
  <div class="wrap cs" data-pagefind-body>
    <header class="head">
      <h1 data-pagefind-meta="title">Cheat sheets</h1>
      <p class="lead">Short summaries to review before a mock exam. Print them (Ctrl + P): the site menu is hidden on paper.</p>
      {sheets.length > 0 && <nav class="toc no-print" aria-label="Cheat sheets"><ol>{sheets.map((s) => <li><a href={`#${s.id}`}><Inline c={s.title} /></a></li>)}</ol></nav>}
    </header>
    {sheets.length === 0 && <p class="empty">The cheat sheets appear here once the book has been converted.</p>}
    {sheets.map((s) => (
      <section class="sheet" id={s.id} aria-labelledby={`${s.id}-h`}>
        <h2 id={`${s.id}-h`}><Inline c={s.title} /></h2>
        {s.steps.map((st, i) => (<>{i > 0 && <h3 class="sub"><Inline c={st.title} /></h3>}<StaticBlocks blocks={st.blocks} figures={figuresFor(st.blocks)} /></>))}
      </section>
    ))}
  </div>
</Base>
<style>
  .cs { padding-block: 40px 16px; max-width: 980px; }
  .lead { color: var(--muted); font-size: var(--fs-lg); }
  .toc ol { columns: 2; padding-left: 1.2em; margin: 16px 0 0; }
  .toc li { margin: 3px 0; }
  .sheet { margin-top: 36px; padding-top: 24px; border-top: 2px solid var(--line); scroll-margin-top: calc(var(--header-h) + 12px); }
  .sheet h2 { margin-bottom: 8px; }
  .sub { margin: 20px 0 6px; font-size: var(--fs-lg); }
  .empty { color: var(--muted); }
  @media print { .sheet { break-before: page; border: 0; } .cs { max-width: none; } }
</style>
