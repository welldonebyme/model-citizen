---
// Test page (e2e build only): the delight islands mounted the way the lead will mount them
// (Today: compact panel; dashboard: full panel; chapter page: Explain it back; Base: DelightChrome).
import Base from '../../../src/layouts/Base.astro';
import XpBadgesPanel from '../../../src/components/delight/XpBadgesPanel';
import ExplainBack from '../../../src/components/delight/ExplainBack.astro';
import DelightChrome from '../../../src/components/delight/DelightChrome.astro';
import { chapters } from '../../../src/lib/content';

const ch = chapters.find((c) => c.id === 'ch07') ?? chapters[0];
const steps = ['First step', 'Second step', 'Third step'];
---
<Base title="Delight (test)">
  <div class="wrap" style="padding-block: 32px; display: grid; gap: 24px; max-width: 1100px">
    <h1>Delight islands (test page)</h1>
    <div style="display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 24px; align-items: start" class="t-demo">
      <div data-testid="full"><XpBadgesPanel client:load variant="full" id="badges-full" /></div>
      <div data-testid="compact"><XpBadgesPanel client:load variant="compact" /></div>
    </div>
    <div data-lesson="test">
      {steps.map((t, i) => (
        <section class="step" id={`st-${i}`} data-step={`st-${i}`} aria-labelledby={`st-${i}-h`} style="min-height: 70vh; border-top: 1px solid var(--line); padding-top: 16px">
          <h2 id={`st-${i}-h`}>{t}</h2>
          <p>Text of the {t.toLowerCase()}.</p>
        </section>
      ))}
    </div>
    <ExplainBack chapter={ch} />
  </div>
  <DelightChrome badgesHref="#badges" />
</Base>
<style>
  @media (max-width: 900px) { .t-demo { grid-template-columns: 1fr !important; } }
</style>
