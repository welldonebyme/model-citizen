 "about": "Extra YAML selector forms appended to selectors.yml of tag ch18, run with real dbt 1.11.16: dbt -q ls --selector <name> (by the selection-engine agent).",
 "yml": "\n  - name: y_cautious\n    definition:\n      method: fqn\n      value: stg_jaffle_shop__orders\n      indirect_selection: cautious\n\n  - name: y_buildable_children\n    definition:\n      method: fqn\n      value: stg_jaffle_shop__customers\n      children: true\n      children_depth: 1\n      indirect_selection: buildable\n\n  - name: y_at\n    definition:\n      method: fqn\n      value: int_orders__enriched\n      childrens_parents: true\n\n  - name: y_parents_depth\n    definition:\n      method: fqn\n      value: fct_orders\n      parents: true\n      parents_depth: 1\n\n  - name: y_depth_without_flag\n    definition:\n      method: fqn\n      value: fct_orders\n      parents_depth: 1\n\n  - name: y_inherit\n    definition:\n      union:\n        - method: selector\n          value: finance_marts\n        - method: tag\n          value: staging\n\n  - name: y_method_exclude\n    definition:\n      method: tag\n      value: marts\n      exclude:\n        - method: fqn\n          value: fct_orders\n          children: true\n\n  - name: y_nested\n    definition:\n      intersection:\n        - union:\n            - method: tag\n              value: finance\n            - method: tag\n              value: marketing\n        - method: config.materialized\n          value: table\n\n  - name: y_union_exclude_many\n    definition:\n      union:\n        - method: path\n          value: models/marts\n        - exclude:\n            - method: tag\n              value: finance\n            - method: resource_type\n              value: test\n\n  - name: y_string_ops\n    definition: '@stg_stripe__payments'\n\n  - name: y_test_type\n    definition:\n      method: test_type\n      value: singular\n",
