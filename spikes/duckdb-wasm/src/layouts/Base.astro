---
interface Props { title: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · dbt academy spike</title>
    <style is:global>
      :root {
        --bg: #fbfaf7; --fg: #1d1d1b; --muted: #6b6a66; --line: #e3e0d8; --accent: #2a6f97;
        --ok: #2e7d32; --bad: #b3261e; --code-bg: #f3f1ec;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #161615; --fg: #ecebe7; --muted: #a3a29c; --line: #34332f; --accent: #7cb7da; --ok: #81c784; --bad: #ef9a9a; --code-bg: #1f1f1d; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); line-height: 1.55; }
      main { max-width: 52rem; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
      nav { display: flex; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid var(--line); font-size: .9rem; }
      a { color: var(--accent); }
      pre, code { font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace; font-size: .88em; }
      pre { background: var(--code-bg); padding: .75rem 1rem; overflow-x: auto; border-radius: 6px; }
    </style>
  </head>
  <body>
    <nav><a href={base}>Home</a><a href={`${base}read/`}>Reading page</a><a href={`${base}lab/`}>SQL lab</a><a href={`${base}parity/`}>Parity</a></nav>
    <main><slot /></main>
  </body>
</html>
